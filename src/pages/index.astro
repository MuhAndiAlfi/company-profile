---
import Layout from "../layouts/Layout.astro";
import Img from "../components/Img.astro";
import Icon from "../components/Icon.astro";
import settings from "../data/settings.json";
import home from "../data/home.json";

const { hero, services, clients, features, showcase, testimonials } = home;
const waLink = `https://wa.me/${settings.whatsapp}?text=${encodeURIComponent(settings.waMessage)}`;
const nav = [
  { label: "Layanan", href: "#services" },
  { label: "Partner / Klien", href: "#klien" },
  { label: "Portofolio", href: "#portfolio" },
];
const formatDate = (d: string) =>
  new Date(d).toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" });
// Logo klien digandakan supaya marquee berputar mulus
const marquee = [...clients.items, ...clients.items];
---

<Layout>
  <!-- Header -->
  <header class="sticky top-0 z-40 border-b border-slate-100 bg-white/90 backdrop-blur">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
      <a href="#" class="flex items-center gap-3">
        {settings.logo ? (
          <img src={settings.logo} alt={settings.brandName} class="h-10 w-10 rounded-lg object-contain" />
        ) : (
          <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-500 text-white"><Icon name="cube" /></span>
        )}
        <span class="leading-tight">
          <span class="block text-base font-extrabold tracking-tight">{settings.brandName}</span>
          <span class="block text-xs text-slate-500">{settings.brandTagline}</span>
        </span>
      </a>
      <nav class="hidden items-center gap-8 text-sm font-medium text-slate-600 md:flex">
        {nav.map((n) => <a href={n.href} class="hover:text-brand-600">{n.label}</a>)}
      </nav>
      <a href={waLink} target="_blank" rel="noopener" class="hidden rounded-full bg-brand-500 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-600 sm:inline-flex">
        Konsultasi Gratis
      </a>
      <button id="menu-btn" class="rounded-lg p-2 text-slate-700 md:hidden" aria-label="Buka menu">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
      </button>
    </div>
    <nav id="mobile-menu" class="hidden border-t border-slate-100 px-4 pb-4 md:hidden">
      {nav.map((n) => <a href={n.href} class="block py-3 text-sm font-medium text-slate-700">{n.label}</a>)}
      <a href={waLink} target="_blank" rel="noopener" class="mt-2 block rounded-full bg-brand-500 px-5 py-2.5 text-center text-sm font-semibold text-white">Konsultasi Gratis</a>
    </nav>
  </header>

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden bg-gradient-to-b from-brand-50 to-white">
      <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:py-24">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-brand-700">
            <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>{hero.badge}
          </span>
          <h1 class="mt-5 text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl lg:text-6xl">{hero.title}</h1>
          <p class="mt-5 max-w-xl text-lg text-slate-600">{hero.description}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={waLink} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full bg-brand-500 px-6 py-3 font-semibold text-white shadow-lg shadow-brand-500/25 hover:bg-brand-600">
              <Icon name="wa" class="h-5 w-5" /> Konsultasi Gratis
            </a>
            {settings.catalogPdf && (
              <a href={settings.catalogPdf} target="_blank" rel="noopener" class="inline-flex items-center rounded-full border border-slate-300 bg-white px-6 py-3 font-semibold text-slate-800 hover:border-brand-500 hover:text-brand-600">
                PDF Katalog
              </a>
            )}
          </div>
          <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-slate-700">
            {hero.highlights.map((h) => (
              <li class="flex items-center gap-2"><Icon name="check" class="h-4 w-4 text-brand-500" />{h.text}</li>
            ))}
          </ul>
        </div>
        <div class="relative">
          <div class="absolute -inset-4 -z-0 rounded-[2rem] bg-brand-500/10 blur-2xl"></div>
          <Img src={hero.image} alt={hero.title} class="relative aspect-[4/3] w-full rounded-3xl shadow-xl" />
        </div>
      </div>
    </section>

    <!-- Layanan -->
    <section id="services" class="scroll-mt-20 py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">• Layanan Unggulan</p>
          <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">{services.title}</h2>
          <p class="mt-4 text-slate-600">{services.subtitle}</p>
        </div>
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {services.items.map((s) => (
            <div class="group rounded-2xl border border-slate-200 bg-white p-6 transition hover:-translate-y-1 hover:border-brand-500 hover:shadow-lg">
              <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-600 group-hover:bg-brand-500 group-hover:text-white">
                <Icon name={s.icon} />
              </span>
              <h3 class="mt-5 text-lg font-bold">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{s.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Klien -->
    {clients.items.length > 0 && (
      <section id="klien" class="scroll-mt-20 border-y border-slate-100 bg-slate-50 py-12">
        <p class="text-center text-sm font-semibold uppercase tracking-wider text-slate-500">{clients.title}</p>
        <div class="relative mt-8 overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]">
          <div class="animate-marquee flex w-max gap-14">
            {marquee.map((c) => (
              <div class="flex h-14 items-center">
                {c.logo ? (
                  <img src={c.logo} alt={c.name} class="h-12 w-auto object-contain grayscale transition hover:grayscale-0" />
                ) : (
                  <span class="text-xl font-bold text-slate-400">{c.name}</span>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Fitur (gambar & teks bergantian) -->
    <div id="portfolio" class="scroll-mt-20">
      {features.map((f, i) => (
        <section class="py-16 lg:py-20">
          <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-16">
            <div class={i % 2 === 1 ? "lg:order-2" : ""}>
              <Img src={f.image} alt={f.title} class="aspect-[4/3] w-full rounded-3xl" />
            </div>
            <div>
              <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">• {f.label}</p>
              <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">{f.title}</h2>
              <p class="mt-4 text-lg leading-relaxed text-slate-600">{f.description}</p>
              {f.buttonText && f.buttonUrl && (
                <a href={f.buttonUrl} target="_blank" rel="noopener" class="mt-6 inline-flex rounded-full bg-ink px-6 py-3 font-semibold text-white hover:bg-slate-700">
                  {f.buttonText}
                </a>
              )}
            </div>
          </div>
        </section>
      ))}
    </div>

    <!-- Showcase -->
    <section class="bg-ink py-20 text-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-wider text-brand-500">• Showcase Karya</p>
          <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">{showcase.title}</h2>
          <p class="mt-4 text-slate-300">{showcase.subtitle}</p>
        </div>
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {showcase.items.map((p) => (
            <article class="overflow-hidden rounded-2xl bg-white/5 ring-1 ring-white/10">
              <Img src={p.image} alt={p.title} class="aspect-square w-full" />
              <div class="p-5">
                <span class="text-xs font-semibold uppercase tracking-wider text-brand-500">{p.category}</span>
                <h3 class="mt-2 font-bold">{p.title}</h3>
                <p class="mt-1 text-sm text-slate-400">{p.subtitle}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Testimoni -->
    <section class="py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">• Ulasan Klien</p>
          <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">{testimonials.title}</h2>
        </div>
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {testimonials.items.map((t) => (
            <figure class="flex flex-col rounded-2xl border border-slate-200 p-6">
              <div class="flex gap-0.5 text-amber-400">
                {Array.from({ length: t.rating }).map(() => <Icon name="star" class="h-4 w-4" />)}
              </div>
              <blockquote class="mt-4 flex-1 text-slate-700">“{t.text}”</blockquote>
              <figcaption class="mt-6 flex items-center gap-3">
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-100 font-bold text-brand-700">{t.name.charAt(0).toUpperCase()}</span>
                <span>
                  <span class="block text-sm font-semibold">{t.name}</span>
                  <span class="block text-xs text-slate-500">{formatDate(t.date)}</span>
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="px-4 pb-20 sm:px-6">
      <div class="mx-auto max-w-7xl rounded-3xl bg-brand-500 px-6 py-14 text-center text-white sm:px-12">
        <h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Punya ide project? Yuk diskusikan.</h2>
        <p class="mx-auto mt-4 max-w-xl text-brand-50">Konsultasi gratis, kami bantu pilihkan material dan metode yang paling pas.</p>
        <a href={waLink} target="_blank" rel="noopener" class="mt-8 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 font-semibold text-brand-700 hover:bg-brand-50">
          <Icon name="wa" class="h-5 w-5" /> Chat via WhatsApp
        </a>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="bg-ink text-slate-300">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="text-lg font-extrabold text-white">{settings.brandName}</p>
        <p class="mt-3 text-sm leading-relaxed">{settings.footerDescription}</p>
        <div class="mt-5 flex flex-col gap-2 text-sm">
          <a href={settings.instagramUrl} target="_blank" rel="noopener" class="hover:text-brand-500">Instagram {settings.instagramHandle}</a>
          <a href={settings.marketplaceUrl} target="_blank" rel="noopener" class="hover:text-brand-500">{settings.marketplaceLabel}</a>
        </div>
      </div>
      <div>
        <p class="font-semibold text-white">Layanan</p>
        <ul class="mt-4 space-y-2 text-sm">
          {services.items.map((s) => <li><a href="#services" class="hover:text-brand-500">{s.title}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="font-semibold text-white">Lokasi</p>
        <p class="mt-4 text-sm">{settings.address}</p>
        <a href={settings.mapsUrl} target="_blank" rel="noopener" class="mt-2 inline-block text-sm text-brand-500 hover:underline">Buka Google Maps →</a>
      </div>
      <div>
        <p class="font-semibold text-white">Jam Operasional</p>
        <ul class="mt-4 space-y-2 text-sm">
          {settings.hours.map((h) => <li><span class="block text-white">{h.day}</span>{h.time}</li>)}
        </ul>
      </div>
    </div>
    <div class="border-t border-white/10 py-6 text-center text-xs text-slate-500">
      © {new Date().getFullYear()} {settings.brandName}. All rights reserved.
    </div>
  </footer>

  <!-- Tombol WhatsApp mengambang -->
  <a href={waLink} target="_blank" rel="noopener" aria-label="Chat WhatsApp" class="fixed bottom-5 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg transition hover:scale-110">
    <Icon name="wa" class="h-7 w-7" />
  </a>

  <script>
    const btn = document.getElementById("menu-btn");
    const menu = document.getElementById("mobile-menu");
    btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
    menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => menu.classList.add("hidden")));
  </script>
</Layout>
