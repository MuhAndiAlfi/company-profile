---
// Halaman CMS (Sveltia CMS, kompatibel dengan config Decap). Field diatur di public/admin/config.yml
// Script dikunci versi + hash SRI: kalau isi file di CDN berubah, browser menolak menjalankannya.
// Saat upgrade versi, hitung ulang hash: curl -sL <url> | openssl dgst -sha384 -binary | openssl base64 -A
import { asset } from "../../lib/site";
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin Website</title>
    <link rel="icon" href={asset("/favicon.svg")} />
    <link href={asset("/admin/config.yml")} type="application/yaml" rel="cms-config-url" />
  </head>
  <body>
    <script
      is:inline
      src="https://unpkg.com/@sveltia/cms@0.255.1/dist/sveltia-cms.js"
      integrity="sha384-/ZfxGJ2pp5+UxYN/fCTkbGwnm1ouOPKZXX28NKoGJd7QTv9UZILdcRD/hs2XE+vN"
      crossorigin="anonymous"></script>
  </body>
</html>
